# Optional: the app runs with no .env at all. To change anything, copy this to backend/.env.
PORT=4000

# Product data source (swap by adding a provider; see DECISIONS.md)
PRODUCT_PROVIDER=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# The 5 curated "top rated" products shown on the home page (provider product ids)
FEATURED_PRODUCT_IDS=3,6,9,12,15
# How many top-rated products lead each category page
CATEGORY_TOP_RATED_COUNT=3

# Email provider: "file" (default; writes each email to OUTBOX_DIR), "console" (logs it) or "smtp"
EMAIL_PROVIDER=file
OUTBOX_DIR=./outbox
SALES_INBOX=sales@example.test
EMAIL_FROM=catalogue@example.test
# Only used when EMAIL_PROVIDER=smtp (e.g. AWS SES SMTP credentials — never commit real ones)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where the built client lives (served by the backend)
STATIC_DIR=../frontend/dist
# Only needed if you serve the client from a different origin
CORS_ORIGINS=
